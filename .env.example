# ==========================================
# QuickBite Microservices Environment Config
# ==========================================

# Service Ports
USER_SERVICE_PORT=8081
RESTAURANT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# Database Connection
POSTGRES_HOST=quickbite-db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Database Names
POSTGRES_DB_USER=user_db
POSTGRES_DB_RESTAURANT=restaurant_db
POSTGRES_DB_ORDER=order_db
POSTGRES_DB_NOTIFICATION=notification_db
